# LLM sağlayıcı: lm_studio | openrouter
LLM_PROVIDER=lm_studio

# LM Studio OpenAI-compatible local API
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio

# OpenRouter (Ayarlar’dan da seçilebilir / anahtar kaydedilebilir)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=PoliticalMatrix

# Optional: absolute path for SQLite file (defaults to ./data/politicalmatrix.sqlite)
# DATABASE_PATH=
